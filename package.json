{
  "name": "seattruth",
  "version": "0.3.0",
  "description": "Read-only Stripe and Polar entitlement drift detector for is_pro and seats.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "seattruth": "dist/src/cli.js"
  },
  "license": "MIT",
  "author": {
    "name": "yellowgram",
    "url": "https://www.yellowgram.dev"
  },
  "homepage": "https://www.yellowgram.dev/oss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellowgram/seattruth.git"
  },
  "bugs": {
    "url": "https://github.com/yellowgram/seattruth/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "compare": "npm run build && node dist/src/cli.js",
    "demo": "npm run demo:60s",
    "demo:60s": "npm run build && node dist/scripts/demo-60s.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "yaml": "^2.9.1"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example",
    "mapping.example.yaml",
    "docs"
  ]
}
