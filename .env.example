# SeatTruth environment. Copy to .env. Never commit .env.
# Placeholders only. Do not put a live key in this file.
# --dry-run does not read these values and does not open the network.

# Stripe restricted key (rk_test_ or rk_live_). Secret keys (sk_) are refused.
# Reads used, and nothing else:
# - GET /v1/subscriptions?status=all
#   https://docs.stripe.com/api/subscriptions/list
# - GET /v1/invoices?subscription={id}&expand[]=data.charge
#   https://docs.stripe.com/api/invoices/list
#   https://docs.stripe.com/api/expanding_objects
# Dashboard permissions: Subscriptions Read, Invoices Read, Charges Read
# (the charge is expanded so amount_refunded can be seen).
# https://docs.stripe.com/api/charges/object
# Do not grant write permission. The Refunds API is not called.
STRIPE_RESTRICTED_KEY=rk_test_REPLACE_ME

# Polar Organization Access Token, one organization.
# Create it under Settings → Developers → New Token.
# https://polar.sh/docs/integrate/oat
# That page says "Select the required scopes" and does not list the strings.
# The list-subscriptions operation names the scope:
#   subscriptions:read
# https://polar.sh/docs/api-reference/subscriptions/list
# Grant subscriptions:read only. Confirm that checkbox in the token UI before saving.
# Do not grant subscriptions:write, or any checkout, order, or refund scope.
# SeatTruth does not call Polar order or refund endpoints.
POLAR_RESTRICTED_TOKEN=polar_oat_REPLACE_ME

# Postgres URL for a role that can SELECT the mapped relation and nothing else.
PRODUCT_DATABASE_URL=postgres://seattruth_readonly:REPLACE_ME@db.example:5432/app?sslmode=require

# Incoming webhook for the operator's own Slack channel.
# Live mode posts only for a finding, an ambiguous count, or a run error.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/REPLACE/REPLACE

# Path to the real mapping file (gitignored). The committed example is mapping.example.yaml.
SEATTRUTH_MAPPING_PATH=./mapping.yaml
