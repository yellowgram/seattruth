# SeatTruth environment. Copy to .env. Never commit .env.
# Placeholders only. Do not put a live key in this file.
# The detector is not implemented. The CLI refuses --live and does not read these values yet.

# Stripe restricted key (rk_test_ or rk_live_).
# Dashboard reads: Customers, Subscriptions, and Charges.
# If Refunds is a separate permission, Read on Refunds as well.
# Write permission on nothing. Secret keys (sk_) are refused.
STRIPE_RESTRICTED_KEY=rk_test_REPLACE_ME

# Polar Organization Access Token, tied to one organization.
# Create it under organization Settings → Developers → New Token.
# Read scopes only. Confirm the scope names in that token UI.
# Do not grant write, checkout, or refund-creation scopes.
# Overview: https://polar.sh/docs/integrate/oat
POLAR_RESTRICTED_TOKEN=polar_oat_REPLACE_ME

# Postgres URL for a role that can SELECT the mapped relation and nothing else.
PRODUCT_DATABASE_URL=postgres://seattruth_readonly:REPLACE_ME@db.example:5432/app?sslmode=require

# Incoming webhook for the operator's own Slack channel.
# The stub never POSTs, including when this variable is set.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/REPLACE/REPLACE

# Path to the real mapping file (gitignored). The committed example is mapping.example.yaml.
SEATTRUTH_MAPPING_PATH=./mapping.yaml
